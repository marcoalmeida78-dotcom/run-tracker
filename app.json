{
  "cli": {
    "appVersionSource": "local"
  },
  "expo": {
    "name": "Zero aos 5K",
    "slug": "zero-aos-5k",
    "version": "1.0.0",
    "icon": "assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.marcoalmeida.zeroaos5k",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.marcoalmeida.zeroaos5k",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "WAKE_LOCK",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_ACTIVE_CALORIES_BURNED",
        "android.permission.health.WRITE_TOTAL_CALORIES_BURNED",
        "android.permission.health.WRITE_DISTANCE",
        "android.permission.health.WRITE_VO2_MAX"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "A app necessita de acesso ao GPS para medir a tua distância enquanto corres.",
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": false
        }
      ],
      [
        "react-native-health-connect",
        {
          "rationale": "A app escreve os teus treinos no Health Connect para poderem aparecer na tua app de Saúde & Metabolismo."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./src/app/plugins/withHealthConnectFix.js"
    ],
    "extra": {
      "eas": {
        "projectId": "e72ec802-5f63-4cc8-9c6f-0a7959bb9b39"
      }
    }
  }
}
